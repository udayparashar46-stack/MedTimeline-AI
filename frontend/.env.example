# MedTimeline AI — Frontend Environment Variables
# Copy this file to .env.local and fill in real values. Never commit .env.local to git.

# Backend API base URL.
# Leave empty for local development (Vite proxy handles /api → localhost:8000).
# Set to your Render backend URL for production (no trailing slash).
VITE_API_BASE_URL=https://medtimeline-ai-backend.onrender.com
